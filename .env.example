# ---------------------------------------------------------------------------
# DataTrust configuration. Copy to `.env` and adjust. All defaults target the
# local Docker Compose stack; nothing here points at a paid or hosted service.
# ---------------------------------------------------------------------------

# Runtime profile: "docker" (full stack) or "lightweight" (embedded, no Kafka)
DATATRUST_PROFILE=docker

# --- PostgreSQL -------------------------------------------------------------
DATATRUST_PG_HOST=localhost
DATATRUST_PG_PORT=5432
DATATRUST_PG_DATABASE=datatrust
DATATRUST_PG_USER=datatrust
DATATRUST_PG_PASSWORD=change-me-locally
DATATRUST_PG_MIN_POOL=1
DATATRUST_PG_MAX_POOL=8

# --- Kafka ------------------------------------------------------------------
DATATRUST_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
DATATRUST_KAFKA_CONSUMER_GROUP=datatrust-ingest
DATATRUST_KAFKA_TOPIC_PREFIX=datatrust
DATATRUST_KAFKA_PARTITIONS=3
DATATRUST_KAFKA_REPLICATION_FACTOR=1
# Max records pulled into one processing batch before a durable write
DATATRUST_KAFKA_BATCH_SIZE=500
DATATRUST_KAFKA_POLL_TIMEOUT_SECONDS=1.0
# Bounded retries for transient consumer-side failures
DATATRUST_KAFKA_MAX_RETRIES=3

# --- Storage ----------------------------------------------------------------
# Local filesystem root for Parquet datasets (raw / validated / curated)
DATATRUST_WAREHOUSE_ROOT=./warehouse

# --- Quality / recovery policy ---------------------------------------------
DATATRUST_LATENESS_WATERMARK_MINUTES=60
DATATRUST_FRESHNESS_SLA_MINUTES=15
DATATRUST_VOLUME_ANOMALY_SIGMA=3.0
DATATRUST_RECOVERY_MAX_ATTEMPTS=3
DATATRUST_RECOVERY_BACKOFF_SECONDS=2.0

# --- Simulation -------------------------------------------------------------
DATATRUST_SIM_SEED=20260101
DATATRUST_SIM_EVENTS_PER_SECOND=200

# --- Observability ----------------------------------------------------------
DATATRUST_METRICS_PORT=9108
DATATRUST_LOG_LEVEL=INFO
DATATRUST_LOG_FORMAT=json
